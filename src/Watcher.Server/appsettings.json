{
  "Server": {
    "DataDir": "./server-data",
    "DbPath": "./server-data/watcher.db",
    "MaxUploadSizeMb": 512,
    "AdminUser": "admin",
    "AdminPassword": "",
    "RetentionDays": 30,
    "RetentionMaxBytes": 0,
    "MinFreeDiskPercent": 5,
    "RetentionScanIntervalMinutes": 60,
    "AuditRetentionDays": 365,
    "Transcode": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "MaxRunMinutes": 50,
      "MinAgeMinutes": 30,
      "Crf": 41,
      "Preset": 7,
      "Threads": 1,
      "Workers": 0,
      "MinSavingPercent": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5050" }
    }
  }
}

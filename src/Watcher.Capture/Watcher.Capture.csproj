<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <AssemblyName>Watcher.Capture</AssemblyName>
    <RootNamespace>Watcher.Capture</RootNamespace>
    <!-- Агенту не нужны данные локалей: без системной libicu (минимальный
         AlmaLinux/Debian — падение при старте, watcher-debug 2026-10-13), числа и
         даты — одинаково на любой станции (причина сегмента «motion 0,52%» на
         русской Windows против «0.52%» на Linux). Регистр кириллицы в .NET 8
         работает и в этом режиме. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.34" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Общие файлы агентов/сервера: один исходник, без общей сборки (development.md). -->
  <ItemGroup>
    <Compile Include="..\Shared\CapturedConfigPayload.cs" Link="Shared\CapturedConfigPayload.cs" />
    <Compile Include="..\Shared\RecordingPolicy.cs" Link="Shared\RecordingPolicy.cs" />
    <Compile Include="..\Shared\ActivityLog.cs" Link="Shared\ActivityLog.cs" />
    <Compile Include="..\Shared\BrowserNames.cs" Link="Shared\BrowserNames.cs" />
    <Compile Include="..\Shared\AgentConfigLimits.cs" Link="Shared\AgentConfigLimits.cs" />
    <Compile Include="..\Shared\SafeName.cs" Link="Shared\SafeName.cs" />
    <Compile Include="..\Shared\UserNames.cs" Link="Shared\UserNames.cs" />
    <Compile Include="..\Shared\CaptureStatusFile.cs" Link="Shared\CaptureStatusFile.cs" />
    <Compile Include="..\Shared\RecordingPause.cs" Link="Shared\RecordingPause.cs" />
    <Compile Include="..\Shared\CaptureGeometry.cs" Link="Shared\CaptureGeometry.cs" />
    <Compile Include="..\Shared\CaptureSettings.cs" Link="Shared\CaptureSettings.cs" />
    <Compile Include="..\Shared\ConfigReload.cs" Link="Shared\ConfigReload.cs" />
    <Compile Include="..\Shared\MotionDetectorBase.cs" Link="Shared\MotionDetectorBase.cs" />
    <Compile Include="..\Shared\FrameRing.cs" Link="Shared\FrameRing.cs" />
    <Compile Include="..\Shared\SegmentFiles.cs" Link="Shared\SegmentFiles.cs" />
  </ItemGroup>

  <ItemGroup><Compile Include="..\Shared\DiagnosticSink.cs" Link="Shared\DiagnosticSink.cs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="..\Watcher.Uploader.Core\Watcher.Uploader.Core.csproj" /></ItemGroup>
</Project>

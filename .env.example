# Скопируйте в .env и заполните реальными значениями.
# .env не коммитится (см. .gitignore) — секреты сюда, не в docker-compose.yml.

# Логин/пароль первого пользователя веб-интерфейса (cookie-сессии поверх
# таблицы users, см. docs/configuration.md). Разовый bootstrap: срабатывает
# только пока таблица users пуста — после первого запуска правка здесь
# больше ничего не меняет, см. docs/install.md, «Смена пароля администратора».
Server__AdminUser=admin
Server__AdminPassword=

# Ключ обновлений агентов (H2, docs/operations.md, «Обновление агентов с сервера»)
# — открытый, одной строкой. install-server.sh выпускает пару в /root/watcher-keys
# и пишет сюда сам; вручную:
#   ./tools/update-signing/new-update-key.sh --out ~/watcher-update-key --env .env
# Server__UpdatePublicKey=

# Вход через AD / LDAP (H1, docs/operations.md, «Вход через Active Directory / LDAP»).
# Server__Ldap__Url=ldaps://dc1.corp.local:636
# Server__Ldap__BindDn=svc-watcher@corp.local
# Server__Ldap__BindPassword=
# Server__Ldap__SearchBase=DC=corp,DC=local
# Server__Ldap__GroupRoles__0__Group=Watcher-Admins
# Server__Ldap__GroupRoles__0__Role=admin

# Экспорт журнала доступа в SIEM (H4, docs/configuration.md, «Экспорт в SIEM»).
# Server__Siem__Host=siem.example
# Server__Siem__Port=6514
# Server__Siem__Protocol=tls
# Server__Siem__Format=cef
# Server__Siem__Hostname=watcher.internal

# ТОЛЬКО разработка и тесты: агентские эндпоинты принимают запросы без учётки
# агента (хост — из тела запроса). В продакшене не включать.
# Server__AllowAnonymousAgents=true

# Мониторинг (H4, docs/operations.md, «Мониторинг»): токен для /metrics
# (Prometheus/Zabbix). Пусто — /metrics выключен. openssl rand -hex 24
# Server__MetricsToken=

# Встроенные алерты (H4, docs/configuration.md, «Алерты»): включаются любым
# каналом. Webhook с токеном в URL и пароль SMTP — секреты, только здесь.
# Server__Alerts__Title=Watcher
# Server__Alerts__WebhookUrl=https://mattermost.example/hooks/xxx
# Server__Alerts__Smtp__Host=smtp.example
# Server__Alerts__Smtp__Port=587
# Server__Alerts__Smtp__User=
# Server__Alerts__Smtp__Password=
# Server__Alerts__Smtp__From=watcher@example
# Server__Alerts__Smtp__To=admin@example,security@example

# Адреса, на которых watcher-proxy отдаёт веб-интерфейс и API агентов: имена
# и/или IP через запятую. Первый — адрес для станций (зашивается в комплект
# агентов). install-server.sh ставит IP сервера или --domain.
WATCHER_DOMAIN=localhost
# Сертификат для подключений без SNI (по IP) — первый адрес из WATCHER_DOMAIN.
WATCHER_DEFAULT_SNI=localhost

# Внешний обратный прокси перед Watcher (NPM): ему верим X-Forwarded-For
# (CIDR через пробел; install-server.sh --trusted-proxy).
# WATCHER_TRUSTED_PROXIES=10.20.30.5/32

# Каталог комплекта установки агентов на хосте (install-server.sh, KIT_DIR) —
# в контейнер сервера только на чтение, для страницы «Установка агентов».
# WATCHER_KIT_DIR=/opt/watcher-kit
# Часовой пояс сервера (время в веб-интерфейсе и отчётах) — install-server.sh
# берёт его у хоста при каждом запуске.
# WATCHER_TZ=Europe/Moscow

<?xml version="1.0" encoding="utf-8"?>
<!-- Этап 5 (docs/android-plan.md): политики администратора устройства. Агент —
     владелец устройства (device owner); этого набора хватает для текущих
     этапов (блокировка удаления, авто-выдача разрешений, снятие роли командой).
     Расширяется под этапы 11–13 (политики, команды, киоск). -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android"
    android:visible="true">
    <uses-policies>
        <!-- Снятие роли и самоконтроль администратора. -->
        <force-lock />
        <!-- Задел под этапы 11–12 (управление приложениями/командами); на роль
             владельца не влияет, но объявить заранее дешевле, чем менять потом. -->
        <disable-camera />
        <wipe-data />
    </uses-policies>
</device-admin>

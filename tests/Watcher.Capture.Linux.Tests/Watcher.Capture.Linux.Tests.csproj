<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Watcher.Capture.Linux.Tests</RootNamespace>
    <!-- Тот же режим, что у самого агента (InvariantGlobalization, без ICU). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- BlockingProcess — отдельный тест-хелпер проект, вложенный в эту папку; его
         top-level-statement Program.cs не должен попасть и в эту сборку. -->
    <Compile Remove="BlockingProcess\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Watcher.Capture.Linux\Watcher.Capture.Linux.csproj" />
    <ProjectReference Include="BlockingProcess\BlockingProcess.Linux.csproj" />
  </ItemGroup>

</Project>
